# Salin berkas ini menjadi koneksi.properties lalu sesuaikan.
# koneksi.properties tidak ikut ke GitHub. Tanpa berkas itu, dipakai pengaturan bawaan XAMPP.
url=jdbc:mysql://localhost:3306/ramenku_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
user=root
password=
# Dialek Hibernate. XAMPP memakai MariaDB (bawaan). Untuk MySQL asli: org.hibernate.dialect.MySQLDialect
dialect=org.hibernate.dialect.MariaDBDialect
