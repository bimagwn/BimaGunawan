<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="struk" pageWidth="226" pageHeight="400" columnWidth="202"
              leftMargin="12" rightMargin="12" topMargin="14" bottomMargin="14" isIgnorePagination="true">

    <style name="Dasar" isDefault="true" fontName="Arial" fontSize="9" pdfFontName="Helvetica" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Tebal" style="Dasar" isBold="true" pdfFontName="Helvetica-Bold"/>

    <parameter name="NOTA_ID" class="java.lang.Integer"/>
    <parameter name="WAKTU" class="java.lang.String"/>
    <parameter name="TOTAL" class="java.math.BigDecimal"/>

    <queryString>
        <![CDATA[SELECT m.nama, i.jumlah, i.harga_satuan, i.jumlah * i.harga_satuan AS subtotal
                 FROM penjualan_item i JOIN menu m ON m.id = i.menu_id
                 WHERE i.penjualan_id = $P{NOTA_ID} ORDER BY i.id]]>
    </queryString>
    <field name="nama" class="java.lang.String"/>
    <field name="jumlah" class="java.lang.Integer"/>
    <field name="harga_satuan" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>

    <title>
        <band height="76">
            <staticText>
                <reportElement style="Tebal" x="0" y="0" width="202" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[RAMENKU]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="22" width="202" height="12" forecolor="#555555"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[Struk Penjualan]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="40" width="202" height="1"/>
                <graphicElement><pen lineWidth="0.75" lineStyle="Dashed"/></graphicElement>
            </line>
            <textField>
                <reportElement x="0" y="45" width="202" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Nota No. " + $P{NOTA_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="57" width="202" height="12"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{WAKTU}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="72" width="202" height="1"/>
                <graphicElement><pen lineWidth="0.75" lineStyle="Dashed"/></graphicElement>
            </line>
        </band>
    </title>

    <detail>
        <band height="32">
            <textField isStretchWithOverflow="true">
                <reportElement style="Tebal" x="0" y="3" width="202" height="13"/>
                <textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
            </textField>
            <textField pattern="0 &apos;x&apos;">
                <reportElement x="0" y="17" width="30" height="12"/>
                <textFieldExpression><![CDATA[$F{jumlah}]]></textFieldExpression>
            </textField>
            <textField pattern="&apos;Rp&apos; #,##0">
                <reportElement x="30" y="17" width="82" height="12"/>
                <textFieldExpression><![CDATA[$F{harga_satuan}]]></textFieldExpression>
            </textField>
            <textField pattern="&apos;Rp&apos; #,##0">
                <reportElement x="112" y="17" width="90" height="12"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="70">
            <line>
                <reportElement x="0" y="3" width="202" height="1"/>
                <graphicElement><pen lineWidth="0.75" lineStyle="Dashed"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="Tebal" x="0" y="9" width="70" height="16"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="&apos;Rp&apos; #,##0">
                <reportElement style="Tebal" x="70" y="9" width="132" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="32" width="202" height="1"/>
                <graphicElement><pen lineWidth="0.75" lineStyle="Dashed"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="38" width="202" height="12"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[Terima kasih, sampai jumpa lagi!]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="50" width="202" height="12" forecolor="#888888"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[~ RamenKu ~]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
